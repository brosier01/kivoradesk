<!--
  KivoraDesk network isolation, applied by libvirt to the VM's interface.

  The VM may open connections to the Internet, but not to private networks:
  the host, the homelab LAN, VPNs (WireGuard, Tailscale) or other VMs. Only
  DNS and DHCP on the libvirt gateway are allowed. Connections opened by the
  host to the VM (SSH) keep working because only NEW outgoing traffic is
  dropped.

  @GATEWAY@ is replaced by the libvirt network gateway address.
-->
<filter name='kivoradesk-no-lan' chain='root'>
  <rule action='accept' direction='out' priority='100'>
    <udp dstipaddr='@GATEWAY@' dstportstart='53'/>
  </rule>
  <rule action='accept' direction='out' priority='100'>
    <tcp dstipaddr='@GATEWAY@' dstportstart='53'/>
  </rule>
  <rule action='accept' direction='out' priority='100'>
    <udp dstipaddr='@GATEWAY@' dstportstart='67'/>
  </rule>

  <rule action='drop' direction='out' priority='500'>
    <all state='NEW' dstipaddr='10.0.0.0' dstipmask='8' comment='private (RFC 1918)'/>
  </rule>
  <rule action='drop' direction='out' priority='500'>
    <all state='NEW' dstipaddr='172.16.0.0' dstipmask='12' comment='private (RFC 1918)'/>
  </rule>
  <rule action='drop' direction='out' priority='500'>
    <all state='NEW' dstipaddr='192.168.0.0' dstipmask='16' comment='private (RFC 1918)'/>
  </rule>
  <rule action='drop' direction='out' priority='500'>
    <all state='NEW' dstipaddr='169.254.0.0' dstipmask='16' comment='link-local'/>
  </rule>
  <rule action='drop' direction='out' priority='500'>
    <all state='NEW' dstipaddr='100.64.0.0' dstipmask='10' comment='carrier-grade NAT, Tailscale'/>
  </rule>
</filter>
