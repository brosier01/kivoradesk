{
  "URLBlocklist": [
    "file://*",
    "chrome://*",
    "chrome-search://*",
    "devtools://*",
    "chrome-devtools://*",
    "view-source:*",
    "javascript://*",
    "localhost:5900", "127.0.0.1:5900", "[::1]:5900", "0.0.0.0:5900",
    "localhost:6080", "127.0.0.1:6080", "[::1]:6080", "0.0.0.0:6080",
    "localhost:9222", "127.0.0.1:9222", "[::1]:9222", "0.0.0.0:9222"
  ],
  "URLAllowlist": [
    "chrome://newtab",
    "chrome://new-tab-page"
  ],
  "ExtensionInstallBlocklist": ["*"],
  "AllowFileSelectionDialogs": false,
  "DownloadRestrictions": 3,
  "PasswordManagerEnabled": false,
  "AutofillAddressEnabled": false,
  "AutofillCreditCardEnabled": false,
  "BrowserSignin": 0,
  "SyncDisabled": true
}
