# Shared settings for the kivora-* OpenRC services.

# Unprivileged account that owns the desktop session.
KIVORA_USER="agent"

# X display number and screen geometry. The geometry is the coordinate space
# used by every Computer Use action, so keep it fixed.
KIVORA_DISPLAY=":1"
KIVORA_SCREEN="1280x800x24"

# Chromium DevTools port, bound to localhost only.
KIVORA_CDP_PORT="9222"

# Extra Chromium command-line flags. The VM has no GPU: without
# --disable-gpu, Chromium emulates one in a separate process for nothing
# (no WebGL either way) and uses about 50 MiB more.
KIVORA_BROWSER_FLAGS="--disable-gpu"

# VNC port, bound to localhost only. Viewers go through the web gateway.
KIVORA_VNC_PORT="5900"

# Web gateway port, bound to localhost only; reach it through an SSH tunnel.
KIVORA_WEB_PORT="6080"
